CC=gcc
CFLAGS=-Wall -Wextra -O2 -pthread
LDFLAGS=-pthread

SERVER=server_9844
CLIENT=client_9844

all: $(SERVER) $(CLIENT)

$(SERVER): server_9844.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

$(CLIENT): client_9844.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(SERVER) $(CLIENT)

run-server: $(SERVER)
	./$(SERVER)

.PHONY: all clean run-server
